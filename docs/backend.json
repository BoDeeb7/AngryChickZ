
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food item on the menu",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the dish" },
        "description": { "type": "string", "description": "Short description of the dish" },
        "price": { "type": "number", "description": "Price in USD" },
        "category": { "type": "string", "description": "Category slug" },
        "imageUrls": { "type": "array", "items": { "type": "string" }, "description": "Array of image URLs" },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "e.g., Spicy, Best Seller" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "Food category for filtering",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name" },
        "slug": { "type": "string", "description": "URL-friendly name" }
      },
      "required": ["name", "slug"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Global store contact and branding information",
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "address": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "tiktok": { "type": "string" }
      }
    },
    "HeroSettings": {
      "title": "Hero Settings",
      "description": "Hero section media and text content",
      "type": "object",
      "properties": {
        "bgImage": { "type": "string" },
        "bannerImage": { "type": "string" },
        "bannerHeadline": { "type": "string" },
        "bannerText": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of menu items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of menu categories"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer feedback"
    },
    "/settings/store": {
      "schema": "StoreSettings",
      "description": "Global store settings"
    },
    "/settings/hero": {
      "schema": "HeroSettings",
      "description": "Hero section content"
    }
  }
}
