
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A high-end product in the Velozi catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "badge": { "type": "string" },
        "stock": { "type": "number" },
        "status": { "type": "string", "enum": ["In Stock", "Low Stock", "Out of Stock"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "price", "category", "images", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "A shopping section or collection category.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "slug"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Collection of all available products."
    },
    "/categories/{categoryId}": {
      "schema": "#/backend/entities/Category",
      "description": "Collection of product categories/sections."
    }
  }
}
