
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to menu items, categories, reviews and store settings
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // In production, restrict this to Admin Auth
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
